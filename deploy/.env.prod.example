APP_NAME=Planner App API
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# GLM (OpenAI-compatible) settings
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Aliyun NLS (Speech-to-Text) settings
ALIYUN_NLS_APPKEY=
ALIYUN_NLS_TOKEN=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_REGION=cn-shanghai
ALIYUN_NLS_ENDPOINT=https://nls-gateway.cn-shanghai.aliyuncs.com
# 0 表示按音频格式自动选择（ogg 默认 48000，wav/pcm 默认 16000）
ALIYUN_NLS_SAMPLE_RATE=0

# PostgreSQL settings (used by docker-compose.yml)
POSTGRES_DB=planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner_password

# Use PostgreSQL in Docker by default
SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://planner:planner_password@db:5432/planner

# SQLite alternative (comment out the PostgreSQL URL above if using SQLite)
# SQLALCHEMY_DATABASE_URL=sqlite:////app/data/planner.db
