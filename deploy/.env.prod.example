APP_NAME=Planner App API
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# PostgreSQL settings (used by docker-compose.yml)
POSTGRES_DB=planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner_password

# Use PostgreSQL in Docker by default
SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://planner:planner_password@db:5432/planner

# SQLite alternative (comment out the PostgreSQL URL above if using SQLite)
# SQLALCHEMY_DATABASE_URL=sqlite:////app/data/planner.db
